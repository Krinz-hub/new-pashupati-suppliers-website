{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-pashupati-suppliers-website",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS"
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://newpashupatisuppliers.com",
    "ADMIN_EMAIL": "admin@pashupatisuppliers.com"
  }
}
